{
  "expo": {
    "name": "AI Fashion Preview ",
    "slug": "ai-fashion-preview",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ic_launcher.png",
    "scheme": "aifashionpreview10",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFDFD",
        "foregroundImage": "./assets/images/ic_launcher_foreground.png",
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.AIFashionPreview_1.x0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AI Fashion Preview to save generated images to your gallery.",
          "savePhotosPermission": "Allow AI Fashion Preview to save generated images to your gallery."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "195707e0-5895-438e-9453-bb1893b23535"
      }
    }
  }
}